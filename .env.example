# ==========================================================================
# Quantum — deployment configuration
#
# Copy this file to `.env` and you are done:
#
#     bash scripts/deploy.sh
#
# The deploy script does the copy for you and fills in every secret with a
# freshly generated random value, so for a local trial you do NOT need to
# edit anything here. Only the GitHub OAuth block (optional) and the public
# hostname block need your input for a real server.
#
# NEVER commit your `.env` — it is gitignored for a reason.
#
# If your `.env` predates the Postgres cutover, old MONGO_DB_*/SESSION_SECRET/
# ENCRYPTION_IV keys may still be sitting in it — deploy.sh only fills in
# missing keys, it never deletes, so those are harmless leftovers you can
# remove by hand whenever convenient.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Where Quantum is reachable
# --------------------------------------------------------------------------
# Leave these three empty and scripts/deploy.sh derives them for you (that is
# how --public and --host work). Fill them in only to pin them by hand.
#
# SERVER_IP must be a bare IPv4 address — no scheme, no port. It is a BIND
# address: 0.0.0.0 means "all interfaces" and is right for both local and
# server installs. It is not a browsing address.
SERVER_IP=

# Public URLs, WITH scheme and port. These are what the BROWSER talks to, so
# they must be reachable from your machine — not from inside the container.
# Never use 0.0.0.0 here: the server allows CORS only from exactly CLIENT_HOST,
# so it has to match the hostname you type in the address bar. Locally that is
# `localhost`; if you browse via 127.0.0.1 instead, set it to 127.0.0.1.
# On a real server that is your IP or domain, e.g.
#   DOMAIN=https://api.quantum.example.com
#   CLIENT_HOST=https://quantum.example.com
DOMAIN=
CLIENT_HOST=

# Host ports published by the stack. Change these if they are already taken.
SERVER_PORT=7080
CLIENT_WEB_APP_PORT=5050

# --------------------------------------------------------------------------
# 2. Secrets — generated by scripts/deploy.sh, never reuse these examples
# --------------------------------------------------------------------------
# SECRET_KEY      signs JWTs                        (any long random string)
# ENCRYPTION_KEY  encrypts stored GitHub tokens      64 hex chars, or base64
#                 for exactly 32 bytes
#
# Generate manually with:
#   openssl rand -hex 32   # SECRET_KEY / ENCRYPTION_KEY
#
# Rotating ENCRYPTION_KEY makes already-stored GitHub tokens undecryptable —
# users simply re-link their GitHub account.
SECRET_KEY=
ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# 3. Database
# --------------------------------------------------------------------------
# Postgres runs inside the stack; the API reaches it over the private
# network and creates its schema automatically on boot. POSTGRES_PORT is
# only the HOST-side port, bound to 127.0.0.1 so it is never exposed to the
# internet.
POSTGRES_USER=quantum
POSTGRES_PASSWORD=
POSTGRES_DB=quantum
POSTGRES_PORT=5432

# --------------------------------------------------------------------------
# 4. GitHub OAuth (optional, but required to deploy repositories)
# --------------------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:              the DOMAIN value above
#   Authorization callback URL: <DOMAIN>/github/oauth/callback
# Leave both blank to run Quantum without the GitHub integration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --------------------------------------------------------------------------
# 5. Automatic domains + HTTPS for your deployments (optional)
# --------------------------------------------------------------------------
# Point a wildcard DNS record (*.apps.example.com -> this server) at the box
# and set BASE_DOMAIN. Every deployment then gets its own HTTPS subdomain,
# issued by Let's Encrypt through the bundled Traefik.
# Leave BASE_DOMAIN blank to skip it entirely — deployments still work and
# are reachable through their published ports.
BASE_DOMAIN=
ACME_EMAIL=
# Switch to the production CA only once staging works, it is rate-limited:
#   https://acme-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --------------------------------------------------------------------------
# 6. Outbound email (optional — password resets, alerts)
# --------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=
WEBMASTER_MAIL=

# --------------------------------------------------------------------------
# 7. Advanced — sane defaults live in docker-compose.yml, override only if
#    you know why. Self-signup starts OPEN: sign up through the web app for
#    your first account, then set REGISTRATION_DISABLED=true here and
#    rebuild (`docker compose up -d --build api`) to lock further signups.
# --------------------------------------------------------------------------
NODE_ENV=production
REGISTRATION_DISABLED=false
