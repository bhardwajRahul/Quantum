# Required. deploy.sh generates the secrets and fills the URLs; set them by hand only with plain compose.
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_USER=quantum
POSTGRES_PASSWORD=
POSTGRES_DB=quantum
POSTGRES_PORT=5432

# How the browser reaches the api and the web app: full URLs with scheme and port, never 0.0.0.0.
DOMAIN=
CLIENT_HOST=
SERVER_PORT=7080
CLIENT_WEB_APP_PORT=5050
SERVER_IP=

# GitHub OAuth app, needed to deploy repositories. Callback URL: <DOMAIN>/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. HTTPS for the dashboard through the bundled Traefik; switch to the production CA once staging works.
PANEL_HOST=
ACME_EMAIL=
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Optional. Password resets and alert emails.
SMTP_HOST=
SMTP_PORT=
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=
WEBMASTER_MAIL=

NODE_ENV=production
REGISTRATION_DISABLED=false
